# ---- Variables de entorno de ChattingSights ----
# Copia este archivo a .env.local y rellena los valores.
# NUNCA subas .env.local al repositorio.

# ---- Cliente (expuesto al navegador, prefijo VITE_) ----
# Precio en céntimos del informe completo (solo para mostrar en UI). Ej: 499 = 4,99 €
VITE_REPORT_PRICE_CENTS=499
VITE_REPORT_CURRENCY=eur
# En desarrollo el informe se muestra entero sin pagar. Pon 'true' para forzar
# el paywall también en local y poder probar el flujo de pago.
VITE_FORCE_PAYWALL=false
# ID de medición de Google Analytics 4 (formato G-XXXXXXXXXX). Déjalo vacío
# para desactivar por completo la analítica (no se carga ningún script).
VITE_GA_ID=

# ---- Servidor (Vercel Functions, NUNCA con prefijo VITE_) ----
# Clave secreta de Stripe (modo test empieza por sk_test_)
STRIPE_SECRET_KEY=sk_test_xxx
# Secreto del webhook de Stripe (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxx
# ID del precio creado en el dashboard de Stripe (price_...)
STRIPE_PRICE_ID=price_xxx
# URL pública del sitio (sin barra final). En local: http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
